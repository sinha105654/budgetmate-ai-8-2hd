{
  "name": "budgetmate-ai",
  "version": "1.0.0",
  "description": "SIT726 8.2HD - BudgetMate AI High-Fidelity Prototype (individual build)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --coverage",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "app.js",
      "routes/**/*.js",
      "utils/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  }
}